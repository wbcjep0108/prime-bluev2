# Normalise line endings across Windows, macOS and Linux.
# Git detects text files and stores them with LF in the repository.
* text=auto

# Source and configuration: LF everywhere.
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.jsx   text eol=lf
*.mjs   text eol=lf
*.cjs   text eol=lf
*.json  text eol=lf
*.css   text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.svg   text eol=lf
.gitignore     text eol=lf
.gitattributes text eol=lf
.env.example   text eol=lf

# Shell scripts must stay LF or they break on macOS/Linux.
*.sh    text eol=lf

# Windows scripts require CRLF.
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# Binary assets: never touch.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.mp4   binary
*.webm  binary
*.mov   binary
*.ttf   binary
*.otf   binary
*.woff  binary
*.woff2 binary
